[TEMPLATE]
# Full backend API base URL including the version prefix,
# e.g. http://localhost:5000/api/v1 or https://api.example.com/api/v1
# Leave empty in development to use the Vite dev proxy (/api/* -> VITE_PROXY_TARGET).
VITE_API_BASE_URL=

# Development only: backend origin that the Vite dev server proxy forwards /api/* requests to.
VITE_PROXY_TARGET=http://localhost:5000
